# Railway PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:5432/database
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret
# Set to true when Railway terminates HTTPS in front of the app
COOKIE_SECURE=true
# Optional: TURN credentials for restrictive networks. Use a reputable TURN provider.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
PORT=3000
